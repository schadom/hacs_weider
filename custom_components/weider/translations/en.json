{
  "config": {
    "step": {
      "user": {
        "title": "Connect a Weider heat pump",
        "description": "Choose how Home Assistant connects to the heat pump.",
        "menu_options": {
          "tcp": "Network (Modbus TCP)",
          "serial": "Serial port (Modbus RTU)",
          "rtu_over_tcp": "RS485 converter on the network (Modbus RTU over TCP)"
        }
      },
      "reconfigure": {
        "title": "Reconfigure Weider heat pump",
        "description": "Choose how Home Assistant connects to the heat pump. Entities that the new connection also provides keep their history.",
        "menu_options": {
          "tcp": "Network (Modbus TCP)",
          "serial": "Serial port (Modbus RTU)",
          "rtu_over_tcp": "RS485 converter on the network (Modbus RTU over TCP)"
        }
      },
      "tcp": {
        "title": "Network (Modbus TCP)",
        "description": "Connect to the Ethernet port of the heat pump.",
        "data": {
          "host": "Host",
          "port": "Port",
          "unit_id": "Unit ID"
        },
        "data_description": {
          "host": "Hostname or IP address of the heat pump. Use a fixed IP address, for example a DHCP reservation.",
          "port": "Modbus TCP port of the heat pump, usually 502.",
          "unit_id": "Modbus unit ID of the heat pump, usually 1."
        }
      },
      "serial": {
        "title": "Serial port (Modbus RTU)",
        "description": "Connect to the RS485 port X9 (Modbus 1) of the controller through a USB-RS485 adapter. Modbus 1 must be set to RTU and slave on the controller, and the settings below must match the controller's settings.",
        "data": {
          "device": "Serial port",
          "baudrate": "Baud rate",
          "parity": "Parity",
          "stopbits": "Stop bits",
          "unit_id": "Unit ID"
        },
        "data_description": {
          "device": "The USB-RS485 adapter. Prefer a /dev/serial/by-id path, which stays the same after a restart.",
          "baudrate": "Baud rate set for Modbus 1 on the controller.",
          "parity": "Parity set for Modbus 1 on the controller.",
          "stopbits": "Stop bits set for Modbus 1 on the controller.",
          "unit_id": "Modbus address set for Modbus 1 on the controller, usually 1."
        }
      },
      "rtu_over_tcp": {
        "title": "RS485 converter (Modbus RTU over TCP)",
        "description": "Connect to the RS485 port X9 (Modbus 1) of the controller through an RS485-to-Ethernet converter in transparent mode. Set the serial settings on the converter to match the controller's Modbus 1 settings.",
        "data": {
          "host": "Host",
          "port": "Port",
          "unit_id": "Unit ID"
        },
        "data_description": {
          "host": "Hostname or IP address of the converter.",
          "port": "TCP port of the converter's transparent mode.",
          "unit_id": "Modbus address set for Modbus 1 on the controller, usually 1."
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect"
    },
